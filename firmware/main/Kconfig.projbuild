menu "Appliance settings"
config APPLIANCE_DEVICE_ID
    string "Device ID"
    default "device-0001"
config APPLIANCE_WIFI_SSID
    string "Wi-Fi SSID"
    default ""
config APPLIANCE_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""
config APPLIANCE_BLE_PROVISIONING
    bool "Provision Wi-Fi using the ESP BLE Provisioning app"
    default n
    depends on BT_ENABLED
config APPLIANCE_PROVISION_POP
    string "Unique device proof of possession (at least 16 characters)"
    default ""
    depends on APPLIANCE_BLE_PROVISIONING
    help
        Supplied out of band to the owner. Never log this secret or reuse it
        across devices. An empty value refuses first-time provisioning.
config APPLIANCE_MQTT_URI
    string "TLS broker URI"
    default "mqtts://localhost:8883"
config APPLIANCE_MQTT_PASSWORD
    string "Device MQTT password"
    default ""
config APPLIANCE_OUTPUT_GPIO
    int "Low voltage demonstration output GPIO"
    default 2
config APPLIANCE_OTA_URL
    string "Optional HTTPS application firmware URL"
    default ""
config APPLIANCE_OTA_USE_BROKER_CA
    bool "Use the local broker CA for attended HTTPS OTA"
    default n
endmenu
